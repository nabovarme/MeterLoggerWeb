<HEAD>
	<meta name="robots" content="noindex">
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<TITLE>MeterLogger WiFi Update</TITLE>

	<!-- Dygraph & general styles -->
	<style type="text/css">
	.dygraph-legend { font-family: Verdana, Geneva, sans-serif; text-align: left; background: none; position: fixed; top: 500px; right: 20px; }
	.dygraph-label { font-family: Verdana, Geneva, sans-serif; text-align: left; background: none; }
	.dygraph-axis-label { font-family: Verdana, Geneva, sans-serif; }
	.highlight { font-weight: bold; }
	.default { font-family: Verdana, Geneva, sans-serif; }
	.default-small { font-family: Verdana, Geneva, sans-serif; font-size: 50%; }
	.default-bold { font-family: Verdana, Geneva, sans-serif; font-weight: bold; }
	.default-highlight { font-family: Verdana, Geneva, sans-serif; background-color:#FFFF00; }
	td input { width: 100%; box-sizing: border-box; }
	</style>

	<!-- Burger menu CSS & JS -->
	<link rel="stylesheet" href="/css/menu.css">
	<script src="/js/menu.js.epl" defer></script>
</HEAD>

<BODY>

<!-- Burger menu wrapper -->
<div class="menu-wrap"></div>

<div id="loading-msg" class="default" style="padding: 20px;">
	Loading meter details...
</div>

<div id="error-msg" class="default-bold" style="display:none; padding: 20px; color: red;">
</div>

<form id="wifi-update-form" onsubmit="return submitWifiUpdate(event)" style="display:none;">
	<input type="hidden" name="serial" id="input-serial" value="">
	<table border="0" align="left" cellpadding="0" cellspacing="6">
		<tr align="left" valign="bottom">
			<td align="left">
				<span class="default-bold" id="display-info"></span><br>
				<span class="default" id="display-serial"></span><br>
			</td>
		</tr>
		<tr align="left" valign="bottom">
			<td>&nbsp;</td>
		</tr>
		<tr align="left" valign="bottom">
			<td align="left">
				<span class="default-bold">SSID</span><br>
				<span class="default">
					<input type="text" inputmode="text" name="ssid" id="input-ssid" value="" size="32">
				</span>
			</td>
		</tr>
		<tr align="left" valign="bottom">
			<td align="left">
				<span class="default-bold">Password</span><br>
				<span class="default">
					<input type="text" inputmode="text" name="password" id="input-password" value="" size="32">
				</span>
			</td>
		</tr>						
		<tr align="left" valign="bottom">
			<td>&nbsp;</td>
		</tr>
		<tr align="left" valign="bottom">
			<td align="left"><input type="submit" id="update-btn" name="update" value="Update"></td>
		</tr>
		<tr align="left" valign="bottom">
			<td>&nbsp;</td>
		</tr>
	</table>
</form>

<script>
	document.addEventListener("DOMContentLoaded", function() {
		// Read URL parameters native to the browser
		const params = new URLSearchParams(window.location.search);
		const serial = params.get('serial');
		
		if (!serial) {
			document.getElementById('loading-msg').style.display = 'none';
			document.getElementById('error-msg').innerText = 'Error: No serial provided.';
			document.getElementById('error-msg').style.display = 'block';
			return;
		}
		
		// Ask the API endpoint for the info required to populate the UI
		const fetchUrl = '/api/wifi_update?' + params.toString();
		
		fetch(fetchUrl)
			.then(res => res.json())
			.then(data => {
				document.getElementById('loading-msg').style.display = 'none';
				
				if (data.status === 'ok') {
					document.title = data.info + ' MeterLogger';
					
					document.getElementById('display-info').innerText = data.info;
					document.getElementById('display-serial').innerText = 'serial ' + data.serial;
					
					document.getElementById('input-serial').value = data.serial;
					document.getElementById('input-ssid').value = data.ssid || '';
					document.getElementById('input-password').value = data.password || '';
					
					document.getElementById('wifi-update-form').style.display = 'block';
				} else {
					document.getElementById('error-msg').innerText = 'Access Denied: ' + (data.error || 'Unauthorized');
					document.getElementById('error-msg').style.display = 'block';
				}
			})
			.catch(err => {
				console.error(err);
				document.getElementById('loading-msg').style.display = 'none';
				document.getElementById('error-msg').innerText = 'Network error communicating with server.';
				document.getElementById('error-msg').style.display = 'block';
			});
	});

	function submitWifiUpdate(e) {
		e.preventDefault(); 
		
		var btn = document.getElementById('update-btn');
		btn.value = 'Updating...';
		btn.disabled = true;
		
		var payload = {
			serial: document.getElementById('input-serial').value,
			ssid: document.getElementById('input-ssid').value,
			password: document.getElementById('input-password').value
		};
		
		fetch('/api/wifi_update', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(payload)
		})
		.then(res => res.json())
		.then(data => {
			if (data.status === 'ok') {
				btn.value = 'Updated';
				alert('WiFi credentials successfully sent to meter queue.');
			} else {
				btn.value = 'Update';
				alert('Failed: ' + (data.error || 'Unknown error'));
			}
		})
		.catch(err => {
			console.error(err);
			btn.value = 'Update';
			alert('Network error communicating with server.');
		})
		.finally(() => {
			btn.disabled = false;
		});
		
		return false;
	}
</script>

<br>
<br>
<br>
<br>

</BODY>
</HTML>
