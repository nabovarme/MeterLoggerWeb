<HTML>
[- 
	use Time::Format qw( time_format );
	use POSIX qw( mktime );

	use Nabovarme::Db;
	use Nabovarme::Admin;
	use Nabovarme::Utils;

	$admin = new Nabovarme::Admin;
	$is_admin = $admin->cookie_is_admin_for_serial($req_rec, $fdat{'serial'});

	# Variables for recurring membership state
	$sub_enabled = 0;
	$sub_amount = '';
	$sub_info = '';
	$sub_frequency = 'monthly';
	$sub_next = '';
	$show_subscription_panel = 0;

	# Handle saving/updating the Recurring Membership configuration
	if ($is_admin && $fdat{action} eq 'update_subscription') {
		if ($dbh = Nabovarme::Db->my_connect) {
			my $enabled = $fdat{sub_enabled} ? 1 : 0;
			my $amount = (defined $fdat{sub_amount} && length $fdat{sub_amount}) ? Nabovarme::Admin::normalize_amount($fdat{sub_amount}) : 0;
			my $info_prefix = (defined $fdat{sub_info} && length $fdat{sub_info}) ? $fdat{sub_info} : 'Membership';
			my $frequency = (defined $fdat{sub_frequency} && length $fdat{sub_frequency}) ? $fdat{sub_frequency} : 'monthly';
			
			# If it's a new subscription, default the next payment to the 1st of next month at 00:00:00
			my ($sec, $min, $hour, $mday, $mon, $year) = localtime(time());
			my $next_payment_time = POSIX::mktime(0, 0, 0, 1, $mon + 1, $year);

			my $sub_sth = $dbh->prepare(qq[
				INSERT INTO subscriptions (serial, enabled, amount, frequency, info_prefix, next_payment_time)
				VALUES (?, ?, ?, ?, ?, ?)
				ON DUPLICATE KEY UPDATE
					enabled = VALUES(enabled),
					amount = VALUES(amount),
					frequency = VALUES(frequency),
					info_prefix = VALUES(info_prefix)
			]);
			$sub_sth->execute($fdat{serial}, $enabled, $amount, $frequency, $info_prefix, $next_payment_time);
		}
		# Redirect to clear query parameters
		$http_headers_out{'Location'} = "detail_acc.epl?serial=" . $fdat{serial};
	}

	# Handle creation of one-off manual payments, memberships, or charges
	if ($is_admin && ($fdat{add_state} =~ /add/i)) {
		$admin->add_payment($fdat{serial}, $fdat{type}, $fdat{unix_time}, $fdat{info}, $fdat{amount}, $fdat{price});
		$http_headers_out{'Location'} = "detail_acc.epl?serial=" . $fdat{serial};
	}

	if ($dbh = Nabovarme::Db->my_connect) {
		my $quoted_serial = $dbh->quote($fdat{'serial'});
		$meter_info_sth = $dbh->prepare(qq[SELECT `info` FROM meters WHERE `serial` like $quoted_serial]);
		$meter_info_sth->execute;

		$latest_sample_sth = $dbh->prepare(qq[SELECT hours, volume, energy FROM samples_cache WHERE serial LIKE $quoted_serial ORDER BY `unix_time` DESC LIMIT 1]);
		$latest_sample_sth->execute;

		if ($meter_info_sth->rows) {
			if ($d = $meter_info_sth->fetchrow_hashref) {
				$info = $d->{info};
			}
		}

		# Only fetch subscription admin data if the user is actually an admin
		if ($is_admin) {
			# 1. Check if the meter's group has subscriptions enabled
			# Using backticks around `group` because it's a reserved SQL keyword
			my $grp_check_sth = $dbh->prepare(qq[
				SELECT mg.subscription_enabled 
				FROM meters m 
				JOIN meter_groups mg ON m.`group` = mg.id 
				WHERE m.serial = ?
			]);
			$grp_check_sth->execute($fdat{'serial'});
			if (my $grp = $grp_check_sth->fetchrow_hashref) {
				$show_subscription_panel = $grp->{subscription_enabled} ? 1 : 0;
			}

			# 2. Fetch current recurring membership state for the UI (only if the panel should be shown)
			if ($show_subscription_panel) {
				my $sub_fetch_sth = $dbh->prepare(qq[SELECT enabled, amount, frequency, info_prefix, next_payment_time FROM subscriptions WHERE serial = ?]);
				$sub_fetch_sth->execute($fdat{'serial'});
				if (my $sub = $sub_fetch_sth->fetchrow_hashref) {
					$sub_enabled = $sub->{enabled};
					$sub_amount = $sub->{amount};
					$sub_frequency = $sub->{frequency} || 'monthly';
					$sub_info = $sub->{info_prefix} || 'Membership';
					$sub_next = $sub->{next_payment_time} ? time_format('dd.mm.yyyy', $sub->{next_payment_time}) : '';
				}
			}
		}
	}
-] 
	<HEAD>
		<meta name="robots" content="noindex">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<TITLE>[+ $info +] MeterLogger</TITLE>
		<script type="text/javascript">
			var meter_serial = "[+ $fdat{'serial'} +]"
		</script>

		<!-- style and js for burger menu -->
		<link rel="stylesheet" href="/css/menu.css">
		<script src="/js/menu.js.epl" defer></script>	

		<script src="/js/dygraph.min.js"></script>
		<link rel="stylesheet" href="/css/dygraph.css">

		<link rel="stylesheet" href="/css/detail.css">
	</HEAD>
	<BODY>
		<div id="error_message"></div>
		
		<!-- Expanded page wrapper encapsulates all panels -->
		<div class="page-wrapper">
			<!-- >
				<div class="watermark">BETA-TEST</div>
			< -->
			<span class="default-header">
				[+ $info +]
			</span>
			<span class="default">
				Consumption <a href="detail.epl?serial=[+ $fdat{'serial'} +]">Details</a>
			</span>
			<span class="default-small">
				<a href="/qr/[+ $fdat{'serial'} +]">QR</a>
				[$ if ($is_admin) $] <a href="update_wifi.epl?serial=[+ $fdat{'serial'} +]">Update wifi</a>[$ endif $]
			</span>
			<br>
			<span class="default">
				serial [+ $fdat{'serial'} +]<br>
				<div id="last_energy"></div>
			</span>
			
			<div id="dygraph_container" style="position: relative;">
				<div id="div_dygraph"></div>
				<div id="graph_spinner" class="spinner-overlay">
					<div class="spinner"></div>
				</div>
			</div>

			<!-- Statistics panel -->
			<div id="stats_panel">
				<div id="consumption_in_range"></div>
				<div id="kwh_remaining"></div>
			</div>

			<!-- Account history panel -->
			<div id="payments_table" align="left" valign="bottom"></div>

		[$ if ($is_admin) $]
			[$ if ($fdat{add_state} =~ /preview/i) $]
			<!-- Add Payment Panel (Preview) -->
			<form method="GET" action="">
			<div id="add_payment" align="left" valign="bottom">
				<div class="default-bold panel-header">Add Payment (Preview)</div>
				<div class="payment-row">
					<div class="cell">
						<span class="default-highlight">
							[+ time_format('dd.mm.yyyy hh:mm:ss', time()) +]
						</span>
					</div>
					<div class="cell">
						<span class="default-highlight">
							[$ if $fdat{type} eq 'payment' $][+ sprintf("%.0f", (Nabovarme::Admin::normalize_amount($fdat{amount}) / Nabovarme::Admin::normalize_amount($fdat{price}))) . " kWh" +] [$ endif $][+ $fdat{info} +]
						</span>
					</div>
					<div class="cell">
						<span class="default-highlight">
							[+ Nabovarme::Admin::normalize_amount($fdat{amount}) +] kr
						</span>
					</div>
					<div class="cell">
						<span class="default-highlight">
							[$ if $fdat{type} eq 'payment' $][+ Nabovarme::Admin::normalize_amount($fdat{price}) +] kr/kWh[$ endif $]
						</span>
					</div>
				</div>
				<div class="payment-row">
					<div class="cell">
						<input type="hidden" name="serial" value="[+ $fdat{serial} +]">
						<input type="hidden" name="type" value="[+ $fdat{type} +]">
						<input type="hidden" name="low" value="[+ $fdat{low} +]">
						<input type="hidden" name="unix_time" value="[+ time() +]">
						<input type="hidden" name="info" value="[+ $fdat{info} +]">
						<input type="hidden" name="amount" value="[+ $fdat{amount} +]">
						<input type="hidden" name="price" value="[+ $fdat{price} +]">
						<input type="hidden" name="add_state" value="add">
						<input type="submit" name="add" value="Add" style="width: 100px;">
					</div>
					<div class="cell"></div>
					<div class="cell"></div>
					<div class="cell"></div>
				</div>
			</div>
			</form>
			[$ else $]
			
			<!-- Add Payment Panel (Input) -->
			<form method="GET" action="">
			<div id="add_payment" align="left" valign="bottom">
				<div class="default-bold panel-header">Add Payment</div>
				<div class="payment-row">
					<div class="cell">
						<select name="type">
							<option value="payment">Payment</option>
							<option value="membership">Membership</option>
							<option value="charge">Charge</option>
						</select>
					</div>
					<div class="cell">
						<input type="text" inputmode="text" name="info" value="" size="32" placeholder="Info">
					</div>
					<div class="cell">
						<input type="text" inputmode="text" name="amount" value="" size="5" placeholder="Amount">
					</div>
					<div class="cell">
						<input type="text" inputmode="text" name="price" value="[+ sprintf(qq[%.2f], $admin->default_price_for_serial($fdat{serial})) +]" size="3">
					</div>
				</div>
				<div class="payment-row">
					<div class="cell">
						<input type="hidden" name="serial" value="[+ $fdat{serial} +]">
						<input type="hidden" name="low" value="[+ $fdat{low} +]">
						<input type="hidden" name="add_state" value="preview">
						<input type="submit" name="add" value="Preview" style="width: 100px;">
					</div>
					<div class="cell"></div>
					<div class="cell"></div>
					<div class="cell"></div>
				</div>
			</div>
			</form>

			[$ if ($show_subscription_panel) $]
			<!-- Dedicated Automatic Membership Configuration Panel -->
			<form method="GET" action="">
			<div id="recurring_subscription">
				<div class="default-bold panel-header">
					Automatic Membership 
					<span class="subscription-next">
						([$ if $sub_next $]Next: [+ $sub_next +][$ else $]Next: 1st of month[$ endif $])
					</span>
				</div>
				
				<div class="subscription-row">
					<div class="cell">
						<label class="default">
							<input type="checkbox" name="sub_enabled" value="1" [$ if $sub_enabled $]checked[$ endif $]> Enabled
						</label>
					</div>
					<div class="cell">
						<input type="text" inputmode="text" name="sub_info" value="[+ $sub_info +]" placeholder="Prefix (e.g. Membership)">
					</div>
					<div class="cell">
						<input type="text" inputmode="decimal" class="subscription-amount-input" name="sub_amount" value="[+ $sub_amount +]" placeholder="Amount"> kr
					</div>
					<div class="cell">
						<select name="sub_frequency">
							<option value="monthly" [$ if $sub_frequency eq 'monthly' $]selected[$ endif $]>Monthly</option>
							<option value="quarterly" [$ if $sub_frequency eq 'quarterly' $]selected[$ endif $]>Quarterly</option>
							<option value="yearly" [$ if $sub_frequency eq 'yearly' $]selected[$ endif $]>Yearly</option>
						</select>
					</div>
				</div>

				<div class="subscription-row" style="margin-top: 10px;">
					<div class="cell">
						<input type="hidden" name="serial" value="[+ $fdat{serial} +]">
						<input type="hidden" name="action" value="update_subscription">
						<input type="submit" value="Save Subscription" style="width: 150px;">
					</div>
				</div>
			</div>
			</form>
			[$ endif $]
			
			[$ endif $]
		[$ endif $]
		
		</div> <!-- End of expanded page-wrapper -->

		<script>
			document.addEventListener("keydown", function(e) {
				const active = document.activeElement;

				// Ignore typing in inputs
				if (active.tagName === "INPUT" || active.tagName === "TEXTAREA" || active.isContentEditable) return;

				const menu = document.getElementById("menu");

				// Only when menu is NOT visible
				if (e.key.toLowerCase() === "d" && !e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey) {
					e.preventDefault();
					e.stopImmediatePropagation(); // block menu.js.epl

					window.location.href = "detail.epl?serial=" + meter_serial;
				}
			}, true);
		</script>
		<script src="detail_acc.js"></script>
	</BODY>
</HTML>
